{
  "name": "studytracker-api",
  "version": "2.0.0",
  "description": "Multi-tenant Study Tracker – CBSE / ICSE / Karnataka",
  "main": "server.js",
  "scripts": {
    "start":       "node server.js",
    "dev":         "nodemon server.js",
    "seed":        "node db/seed.js",
    "build":       "npm --prefix ./frontend install && npm --prefix ./frontend run build",
    "db:schema":   "psql $DATABASE_URL -f db/schema.sql"
  },
  "dependencies": {
    "bcryptjs":     "^2.4.3",
    "cors":         "^2.8.5",
    "dotenv":       "^16.4.5",
    "express":      "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg":           "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
